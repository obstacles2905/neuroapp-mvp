# Скопируй в `.env` в корне `mobile/`. Все переменные `EXPO_PUBLIC_*` встраиваются в JS при сборке.

# --- Локальная разработка (по умолчанию) ---
# Nest API origin only (без /api/admin — это URL админки на Vercel: NEXT_PUBLIC_API_BASE)
# Android-эмулятор: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Если true: сразу открыть приложение без экрана входа (только для разработки)
EXPO_PUBLIC_DEV_BYPASS_AUTH=false

# Если true: только логин/регистрация + рабочие биозамеры (осанка, голос, лицо).
# Онбординг, уроки, профиль и остальные табы скрыты. Для разовой APK-сборки.
EXPO_PUBLIC_BIOMETRICS_ONLY=false

# --- Staging / Railway ---
# Чтобы клиент смотрел на удалённый dev API, скопируй `.env.staging.example` → `.env`
# (или возьми EXPO_PUBLIC_API_URL оттуда вручную).
