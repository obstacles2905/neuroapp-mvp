# Staging / preview — мобильный клиент ходит на удалённый Nest на Railway.
# Не коммить `.env`; для переключения скопируй эти строки в `mobile/.env`:
#
#   copy .env.staging.example .env        (Windows)
#   cp .env.staging.example .env          (macOS / Linux)
#
# После смены перезапусти Expo (`npx expo start` / `npm run web`).
# Origin only — без суффикса /api/admin (это URL админки на Vercel).

EXPO_PUBLIC_API_URL=https://backend-production-2829.up.railway.app
EXPO_PUBLIC_DEV_BYPASS_AUTH=false
EXPO_PUBLIC_BIOMETRICS_ONLY=false
